<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#D9E8F6"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Issue Title -->
        <TextView
            android:id="@+id/tvIssueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ceiling Water Leak"
            android:textColor="@color/in_progress_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="In Progress"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Category -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Maintenance"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIssueTitle" />

        <!-- Assigned Staff -->
        <TextView
            android:id="@+id/tvAssignedStaff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Assigned: John"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCategory" />

        <!-- Latest Staff Update -->
        <TextView
            android:id="@+id/tvStaffUpdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Update: Assigned to John"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAssignedStaff" />

        <!-- Assign Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssign"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="Assign"
            android:textSize="12sp"
            app:backgroundTint="@color/accent_yellow"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toStartOf="@id/btnStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStaffUpdate" />

        <!-- Change Status -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="Change Status"
            android:textSize="12sp"
            app:backgroundTint="@color/accent_pink"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnAssign"
            app:layout_constraintTop_toBottomOf="@id/tvStaffUpdate" />

        <!-- Add Update -->
        <EditText
            android:id="@+id/addUpdateNote"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:hint="Add Staff Update Note"
            android:saveEnabled="false"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnStatus"
            app:cornerRadius="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitUpdate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="Submit Update"
            android:textSize="12sp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/addUpdateNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusUpdate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="Submit Status Update"
            android:textSize="12sp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnSubmitUpdate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</com.google.android.material.card.MaterialCardView>