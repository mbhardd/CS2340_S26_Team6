<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/issueCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#D9E8F6"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Issue title -->
        <TextView
            android:id="@+id/tvIssueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="Ceiling Water Leak"
            android:textColor="@color/not_started_red"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="In Progress"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvIssueTitle" />

        <!-- Issue category -->
        <TextView
            android:id="@+id/tvIssueCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:text="Maintenance"
            android:textColor="#000000"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIssueTitle" />

        <!-- Issue priority -->
        <TextView
            android:id="@+id/tvPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="High"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvIssueCategory" />

        <!-- Issue Initials -->
        <TextView
            android:id="@+id/tvIssueInitials"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:text="RR"
            android:textColor="#000000"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/tvIssueCategory"
            app:layout_constraintTop_toBottomOf="@id/tvIssueCategory"
            app:layout_constraintVertical_bias="0.0" />


        <!-- Watch Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWatch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_watch_grey"
            android:drawableStart="@drawable/eye_closed"
            android:drawablePadding="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Watch"
            android:textAllCaps="false"
            android:textColor="@android:color/black"

            app:layout_constraintTop_toBottomOf="@id/tvPriority"
            app:layout_constraintEnd_toEndOf="@id/tvPriority"

            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:id="@+id/layoutExpandable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnWatch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvCreatorUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creator UID:"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvCreationTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creation Time:"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comments:"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:textSize="18sp"/>

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Staff Notes:"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:textSize="18sp"/>

            <LinearLayout
                android:id="@+id/staffContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <Button
                android:id="@+id/btnAddUpdate"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                app:backgroundTint="#F3D47A"
                android:text="Add Update"
                android:layout_marginTop="10dp"
                android:layout_gravity="center_horizontal" />

            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter comment"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>