<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/issueCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#D9E8F6"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Issue title -->
        <TextView
            android:id="@+id/tvIssueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="Ceiling Water Leak"
            android:textColor="@color/not_started_red"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="In Progress"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvIssueTitle" />

        <!-- Issue category -->
        <TextView
            android:id="@+id/tvIssueCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:text="Maintenance"
            android:textColor="#000000"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIssueTitle" />

        <!-- Issue priority -->
        <TextView
            android:id="@+id/tvPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="High"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvIssueCategory" />

        <!-- Issue Initials -->
        <TextView
            android:id="@+id/tvIssueInitials"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:text="RR"
            android:textColor="#000000"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/tvIssueCategory"
            app:layout_constraintTop_toBottomOf="@id/tvIssueCategory"
            app:layout_constraintVertical_bias="0.0" />

        <!-- EXPANDABLE SECTION -->
        <LinearLayout
            android:id="@+id/layoutExpandable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginTop="6dp"

            app:layout_constraintTop_toBottomOf="@id/tvIssueInitials"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Creator UID -->
            <TextView
                android:id="@+id/tvCreatorUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creator UID: 23243984238"
                android:textColor="#000000"
                android:textSize="16sp"/>

            <!-- Creation Time -->
            <TextView
                android:id="@+id/tvCreationTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creation Time: 01/22/26, 3:43 AM"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="2dp"/>

            <!-- Comments Title -->
            <TextView
                android:id="@+id/tvCommentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comments:"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <!-- Comments By User -->
            <TextView
                android:id="@+id/tvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Located in COC 216"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="2dp"/>

            <!-- Status Changes Title -->
            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status Changes:"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <!-- Status Changes -->
            <TextView
                android:id="@+id/tvStatusChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Status changed to urgent"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="2dp"/>

            <!-- Staff Notes Title -->
            <TextView
                android:id="@+id/tvStaffNotesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Staff Notes:"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <!-- Status Changes -->
            <TextView
                android:id="@+id/tvStaffNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Students should stay clear of the room for the whole day"
                android:textColor="@color/staff_note_red"
                android:textSize="16sp"
                android:layout_marginTop="2dp"/>

            <Button
                android:id="@+id/commentButton"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="Add Comment"
                android:textColor="#000000"
                app:backgroundTint="#F3D47A"
                android:textSize= "16sp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStaffNotes"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>