<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="8dp">

    <TextView
        android:id="@+id/optionJohn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="John"
        android:padding="12dp"/>

    <TextView
        android:id="@+id/optionSarah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sarah"
        android:padding="12dp"/>

    <TextView
        android:id="@+id/optionMike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mike"
        android:padding="12dp"/>

    <TextView
        android:id="@+id/optionEmma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emma"
        android:padding="12dp"/>

</LinearLayout>